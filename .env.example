# 天枢 (Arcanum) 环境变量配置

# 运行环境：本地开发用 development；部署时改为 production（启用 Secure Cookie、强制强 JWT 密钥等）
NODE_ENV=development

# 服务端口
PORT=3001

# CORS 允许的前端域名（留空则允许所有来源，生产环境请设置）
CORS_ORIGIN=https://yourdomain.com

# JWT 密钥：生产环境必须设置为两个不同的随机字符串（至少 16 字符，建议 48 以上），否则拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 首次启动时创建的管理员（Admin）初始密码；不填则生产环境随机生成并只在日志里打印一次
ADMIN_INITIAL_PASSWORD=

# LLM 接口与 SMTP 邮件不在这里配置：登录管理员账户后，在「管理后台 → 系统设置」中填写，
# 保存在 data/system/settings.yaml。
